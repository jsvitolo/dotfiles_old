#!/bib/sh

# Google it
google() {
	local term="$@"
	local url="http://www.google.com/search?q=${term// /+}"
	$BROWSER -a Google\ Chrome "$url"
}

# Github
github() {
	local term="$@"
	local url="http://www.github.com/${term// /+}"
	$BROWSER "$url"
}


# Reddit
reddit() {
	local term="$@"
	local url="https://www.reddit.com/r/${term// /+}/"
	$BROWSER -a Google\ Chrome "$url"
}

# Get kubernetes secret
k-secrets() {
	kubectl get secrets $@ -ojson | jq '{name: .metadata.name, data: .data | map_values(@base64d)}'
}

pod_port_forward() {
  local pod_name=$1
  local port=${2:-3000}  # Se a porta não for fornecida, usa 3000 como padrão

  if [ -z "$pod_name" ]; then
    echo "Você deve fornecer o nome do pod como parâmetro."
    return 1
  fi

  echo "Executando port-forward para o pod: $pod_name na porta: $port"
  kubectl port-forward "$pod_name" $port:$port
}

pod_exec() {
  local pod_name=$1

  if [ -z "$pod_name" ]; then
    echo "Você deve fornecer o nome do pod como parâmetro."
    return 1
  fi

  echo "Executando comando remoto no pod: $pod_name"
  kubectl exec -it "$pod_name" -- banking_transfers remote
}
